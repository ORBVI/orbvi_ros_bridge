<launch>
    <arg name="profile" default="mid360" doc="visual: depth cloud; mid360: accumulated registered RGB cloud"/>
    <arg name="fixed_frame" default="$(eval {'visual': 'orbvi_link', 'mid360': 'camera_init'}[arg('profile')])"/>
    <arg name="rviz_config" default="$(eval {'visual': 'rviz-visual.rviz', 'mid360': 'rviz-config.rviz'}[arg('profile')])"/>
    <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find orbvi_ros_bridge)/visuallize_config/$(arg rviz_config) -f $(arg fixed_frame)"
        required="true" />
</launch>
